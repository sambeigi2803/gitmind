# .env.example
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Pooled PostgreSQL connection (PgBouncer / Supabase "Connection Pooling"
# / Neon pooled endpoint). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@pooler-host:6543/gitmind?pgbouncer=true"

# Direct (unpooled) PostgreSQL connection. Used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@db-host:5432/gitmind"

# Auth.js secret - signs JWT session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required by Auth.js in production to construct callback/redirect URLs.
AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials.
# Create at: https://github.com/settings/developers
# Authorization callback URL must be:
#   <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 32-byte (64 hex char) key used to encrypt GitHub access tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Public app URL, used in client-side redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL of the FastAPI backend (no trailing slash).
BACKEND_API_URL="http://localhost:8000"

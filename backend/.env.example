# Environment
ENVIRONMENT=development
DEBUG=true

# Database - same Postgres instance the Next.js app uses.
# Prisma owns migrations for users/accounts/sessions; Alembic owns
# repo_files/code_chunks/jobs.
DATABASE_URL=postgresql://user:password@localhost:5432/gitmind

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MUST match the frontend's values exactly - the backend verifies the
# JWT the frontend issues, and decrypts tokens the frontend encrypted.
AUTH_SECRET=
ENCRYPTION_KEY=

# External APIs
ANTHROPIC_API_KEY=
GITHUB_API_URL=https://api.github.com

# CORS
FRONTEND_ORIGIN=http://localhost:3000
